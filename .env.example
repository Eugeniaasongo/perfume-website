# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ryz?schema=public"

# Public URL of the storefront, used for payment callbacks and SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin portal password (use a long random passphrase) and session signing secret (32+ chars)
ADMIN_PASSWORD=""
SESSION_SECRET=""

# --- Required in production -------------------------------------------------
# Paystack secret key (sk_live_... in production). Without it, dev mode skips the gateway.
PAYSTACK_SECRET_KEY=""

# Arkesel SMS API key for Cash on Delivery OTPs. Without it, dev mode logs the code.
ARKESEL_API_KEY=""
SMS_SENDER_ID="RYZ Parfums"

# Protects /api/cron/expire-orders (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=""

# --- Optional storefront contact details ------------------------------------
NEXT_PUBLIC_SUPPORT_PHONE="+233200000000"
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY="+233 20 000 0000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@ryzparfums.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="233200000000"
