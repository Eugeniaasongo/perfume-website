datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  description     String
  category        String           // Men, Women, Unisex
  concentration   String           // Extrait de Parfum, EDP, EDT
  topNotes        String           // Comma separated string
  heartNotes      String
  baseNotes       String
  longevityRating Int              @default(5) // 1-5 scale
  sillageRating   Int              @default(5) // 1-5 scale
  imageUrl        String?          // Optional product photography; a rendered bottle is shown when empty

  // Inspired By optional metadata
  inspiredHouse   String?
  inspiredName    String?
  inspiredImgUrl  String?
  inspiredEnabled Boolean          @default(true)

  isFeatured      Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  variants        ProductVariant[]
  reviews         Review[]

  @@index([category])
}

model ProductVariant {
  id             String             @id @default(uuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String             @unique
  size           String             // e.g., 30ml, 50ml, 100ml
  pricePesewas   Int                // Integer pesewas
  comparePrice   Int?               // Optional compare price in pesewas
  stock          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  orderItems     OrderItem[]
  reservations   StockReservation[]

  @@index([productId])
}

model InspiredByConfig {
  id              String   @id @default("global")
  globalEnabled   Boolean  @default(true)
  labelOverride   String   @default("INSPIRED BY")
  showImages      Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model Order {
  id              String             @id @default(uuid())
  orderNumber     String             @unique
  status          String             @default("PENDING_PAYMENT")
  paymentProvider String             // PAYSTACK, CASH_ON_DELIVERY
  customerName    String
  customerEmail   String?
  customerPhone   String
  region          String
  city            String
  addressLine     String
  landmark        String?
  ghanaPostGps    String?

  itemsPrice      Int                // Pesewas
  shippingPrice   Int                // Pesewas
  discountPrice   Int                @default(0) // Pesewas
  discountCode    String?
  totalPrice      Int                // Pesewas

  isCodOtpVerified Boolean           @default(false)
  stockReleased   Boolean            @default(false)
  refundedAmount  Int                @default(0) // Pesewas

  // Fulfilment
  riderName       String?
  riderPhone      String?
  deliveryNote    String?
  paidAt          DateTime?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           OrderItem[]
  paymentLedgers  PaymentLedger[]
  codLogs         CodReconciliationLog[]
  auditLogs       AuditLog[]
  notifications   NotificationLog[]

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  quantity         Int
  unitPricePesewas Int
  totalPesewas     Int

  @@index([orderId])
}

model StockReservation {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int
  reference   String         @unique
  expiresAt   DateTime
  isFulfilled Boolean        @default(false)
  isCancelled Boolean        @default(false)
  createdAt   DateTime       @default(now())
}

model PaymentLedger {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   // PAYSTACK, COD
  reference       String   @unique
  amountPesewas   Int
  currency        String   @default("GHS")
  status          String   // SUCCESS, FAILED, PENDING
  hmacSignature   String?
  metadataJson    String?
  createdAt       DateTime @default(now())

  @@index([orderId])
}

model CodReconciliationLog {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedAmount Int      // Pesewas
  collectorName   String
  collectedAt     DateTime @default(now())
  isReconciled    Boolean  @default(true)
  notes           String?

  @@index([orderId])
}

model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Customer {
  id            String   @id @default(uuid())
  phone         String   @unique
  email         String?  @unique
  name          String
  role          String   @default("CUSTOMER")
  isBlacklisted Boolean  @default(false)
  blockReason   String?
  noShowCount   Int      @default(0)
  orderCount    Int      @default(0)
  lastOrderAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model NotificationLog {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel   String   // SMS
  recipient String
  template  String
  message   String
  status    String   // SENT, FAILED, SKIPPED
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model DiscountCode {
  id            String   @id @default(uuid())
  code          String   @unique
  percentageOff Float?   // e.g., 10.0 for 10%
  amountOffGhs  Int?     // Pesewas
  minSpendGhs   Int      @default(0) // Pesewas
  maxUses       Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  actor     String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model BackInStockSubscriber {
  id         String    @id @default(uuid())
  variantId  String
  email      String?
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([variantId, phone])
  @@index([variantId, notifiedAt])
}
